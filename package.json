{
  "name": "kampung-call",
  "version": "0.1.0",
  "private": true,
  "description": "A Singapore field-service training experience built with Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "validate": "node scripts/validate-project.mjs",
    "test": "npm run validate && npm run test:performance && npm run format:check && npm run build",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "format:check": "node scripts/check-format.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.4.0"
  }
}
