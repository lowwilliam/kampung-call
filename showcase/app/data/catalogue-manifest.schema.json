{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kampung-call.invalid/schemas/catalogue-manifest.v1.json",
  "title": "Kampung Call Catalogue Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "$ref": "#/$defs/release" },
    "assets": {
      "type": "array",
      "minItems": 68,
      "maxItems": 68,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "evidenceRef": {
      "type": "object",
      "required": ["id", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "defaultLocale",
        "catalogueSize",
        "productionDomain",
        "correctionsEmail",
        "publishedAt",
        "responsiblePublisher"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "published", "withdrawn"] },
        "defaultLocale": { "const": "en" },
        "catalogueSize": { "const": 68 },
        "productionDomain": { "$ref": "#/$defs/nullableString" },
        "correctionsEmail": { "$ref": "#/$defs/nullableString" },
        "publishedAt": { "$ref": "#/$defs/nullableString" },
        "responsiblePublisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "profileUrl"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "profileUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "category",
        "curatedOrder",
        "locale",
        "model",
        "cardPreview",
        "creatorCredit",
        "adapters",
        "productionMethod",
        "provenance",
        "sources",
        "evidenceStatus",
        "metrics",
        "publication",
        "rights",
        "withdrawn"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "type": "string", "minLength": 1 },
        "curatedOrder": { "type": "integer", "minimum": 1, "maximum": 68 },
        "locale": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "intro", "gameContext", "singaporeContext", "productionStory", "inspiration"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "intro": { "type": "string", "minLength": 1 },
                "gameContext": { "type": "string", "minLength": 1 },
                "singaporeContext": { "type": "string", "minLength": 1 },
                "productionStory": { "type": "string", "minLength": 1 },
                "inspiration": { "$ref": "#/$defs/nullableString" }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sourcePath", "publicPath", "sha256", "byteLength", "contentType"],
          "properties": {
            "file": { "type": "string", "pattern": "\\.glb$" },
            "sourcePath": { "type": "string", "pattern": "^assets/.+\\.glb$" },
            "publicPath": { "type": "string", "pattern": "^/models/.+\\.glb$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "byteLength": { "type": "integer", "minimum": 1 },
            "contentType": { "const": "model/gltf-binary" }
          }
        },
        "cardPreview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourcePath", "publicPath", "sourceModelSha256", "sha256", "contentType"],
          "properties": {
            "status": { "enum": ["missing", "legacy", "ready"] },
            "sourcePath": { "$ref": "#/$defs/nullableString" },
            "publicPath": { "$ref": "#/$defs/nullableString" },
            "sourceModelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sha256": { "$ref": "#/$defs/nullableString" },
            "contentType": { "enum": ["image/png", "image/avif", "image/webp", null] }
          }
        },
        "creatorCredit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "url"],
          "properties": {
            "status": { "enum": ["unverified", "verified"] },
            "name": { "$ref": "#/$defs/nullableString" },
            "url": { "$ref": "#/$defs/nullableString" }
          }
        },
        "adapters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "productionMethod": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "detail"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "label", "url"],
            "properties": {
              "kind": { "enum": ["history", "model-reference", "rights"] },
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "evidenceStatus": { "enum": ["unreviewed", "not-applicable", "source-confirmed", "reasoned-inference", "artistic-interpretation", "mixed"] },
        "metrics": { "type": "object" },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "lastReviewedAt"],
          "properties": {
            "status": { "enum": ["draft", "published", "withdrawn"] },
            "lastReviewedAt": { "$ref": "#/$defs/nullableString" }
          }
        },
        "rights": { "$ref": "#/$defs/rights" },
        "withdrawn": { "type": ["object", "null"] }
      }
    },
    "clearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "reviewedBy", "reviewedAt", "evidenceHash"],
      "properties": {
        "status": { "enum": ["pending", "cleared", "blocked", "legal-review", "permission-pending"] },
        "basis": { "$ref": "#/$defs/nullableString" },
        "reviewedBy": { "$ref": "#/$defs/nullableString" },
        "reviewedAt": { "$ref": "#/$defs/nullableString" },
        "evidenceHash": { "$ref": "#/$defs/nullableString" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "ownership",
        "sourceMedia",
        "trademarkChecks",
        "statutoryPermissions",
        "personRelease",
        "display",
        "download"
      ],
      "properties": {
        "subjectType": { "type": "string", "minLength": 1 },
        "ownership": { "type": "object" },
        "sourceMedia": { "type": "object" },
        "trademarkChecks": { "type": "array" },
        "statutoryPermissions": { "type": "array" },
        "personRelease": { "type": "object" },
        "display": { "$ref": "#/$defs/clearance" },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "license", "scope", "excludedThirdPartyRights", "reviewedBy", "reviewedAt", "evidenceHash"],
          "properties": {
            "status": { "enum": ["blocked", "cleared", "legal-review", "permission-pending"] },
            "license": { "$ref": "#/$defs/nullableString" },
            "scope": { "$ref": "#/$defs/nullableString" },
            "excludedThirdPartyRights": { "type": "array", "items": { "type": "string" } },
            "reviewedBy": { "$ref": "#/$defs/nullableString" },
            "reviewedAt": { "$ref": "#/$defs/nullableString" },
            "evidenceHash": { "$ref": "#/$defs/nullableString" }
          }
        }
      }
    }
  }
}
